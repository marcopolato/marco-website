---
import { Image } from 'astro:assets';
import type { Project } from '../../data/projects.ts';
import { messages, type Locale } from '../../i18n/messages.ts';
import { getPageUrl } from '../../i18n/paths.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chip from '../Chip.astro';
import ProjectLogo from '../ProjectLogo.astro';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const content = project.content[locale];
const t = messages[locale];
const statusLabel =
  project.status === 'in-progress' ? t.projectInProgress : t.projectCompleted;
const { image, branding } = project;
const gallery = project.gallery ?? [];
const isWideGallery = gallery.every(({ src }) => src.width > src.height);
const sections = [
  { id: 'activities', title: t.activitiesTitle, items: content.activities },
  { id: 'learnings', title: t.learningsTitle, items: content.learnings },
];
---

<BaseLayout
  locale={locale}
  title={`${content.title} | ${t.projectPageTitle}`}
  description={content.description}
  projectSlug={project.slug}
>
  <article class="project-detail" aria-labelledby="project-title">
    <a href={getPageUrl(locale, 'projects')}>{t.backToProjects}</a>

    <header class="project-intro">
      <h1 id="project-title">{content.title}</h1>
      {branding?.company && (
        <p class="project-company">
          <ProjectLogo
            src={branding.company.logo}
            width={48}
            loading="eager"
            class="project-company__logo"
          />
          {branding.company.name}
        </p>
      )}
      <p class="project-intro__description">{content.description}</p>
    </header>

    {gallery.length <= 0 && image && (
      <Image
        src={image.src}
        alt={image.alt[locale]}
        width={960}
        layout="constrained"
        fit="contain"
        loading="eager"
        class="project-cover"
      />
    )}

    <dl class="project-facts">
      <div>
        <dt>{t.projectRoleLabel}</dt>
        <dd>{content.role}</dd>
      </div>
      <div>
        <dt>{t.technologiesLabel}</dt>
        <dd>
          <ul class="chip-list" role="list">
            {project.technologies.map((technology) => {
              const logo = branding?.technologyLogos[technology];
              return (
                <li>
                  <Chip>
                    {logo ? (
                      <span class="project-technology">
                        <ProjectLogo
                          src={logo}
                          width={48}
                          class="project-technology__logo"
                        />
                        {technology}
                      </span>
                    ) : (
                      technology
                    )}
                  </Chip>
                </li>
              );
            })}
          </ul>
        </dd>
      </div>
      <div>
        <dt>{t.projectStatusLabel}</dt>
        <dd>{statusLabel}</dd>
      </div>
    </dl>

    <section aria-labelledby="objective">
      <h2 id="objective">{t.objectiveTitle}</h2>
      <p>{content.objective}</p>
    </section>

    {sections.map((section) => (
      <section aria-labelledby={section.id}>
        <h2 id={section.id}>{section.title}</h2>
        <ul>
          {section.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    ))}

    {gallery.length > 0 && (
      <section class="project-gallery" aria-labelledby="project-gallery-title">
        <h2 id="project-gallery-title">{t.projectGalleryTitle}</h2>
        <ul
          class:list={[
            'project-gallery__list',
            { 'project-gallery__list--wide': isWideGallery },
          ]}
          role="list"
        >
          {gallery.map((screenshot) => (
            <li>
              <Image
                src={screenshot.src}
                alt={screenshot.alt[locale]}
                width={Math.min(
                  screenshot.src.width,
                  isWideGallery ? 960 : 512,
                )}
                layout="constrained"
                sizes={
                  isWideGallery ? '(min-width: 66rem) 960px, 92vw' : '256px'
                }
                format={isWideGallery ? 'webp' : undefined}
                class="project-cover"
              />
            </li>
          ))}
        </ul>
      </section>
    )}

    {(project.demoUrl || project.repositoryUrl) && (
      <nav class="project-links" aria-label={t.projectLinksLabel}>
        {project.demoUrl && <a href={project.demoUrl}>{t.viewProject}</a>}
        {project.repositoryUrl && (
          <a
            href={project.repositoryUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.viewCode}
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .project-detail {
    max-width: 60rem;
    margin-inline: auto;
    padding-block: clamp(2rem, 5vw, 4rem);
    overflow-wrap: anywhere;
  }

  .project-intro {
    margin-block: 2rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    letter-spacing: -0.04em;
  }

  .project-intro__description {
    margin-top: 1.25rem;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
  }

  .project-company {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .project-company__logo {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.25rem;
    object-fit: contain;
  }

  .project-cover {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0.375rem;
    background: var(--surface-muted);
  }

  .project-facts {
    display: grid;
    gap: 1.5rem;
    margin-block: 2rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--rule);
  }

  dt {
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  dd {
    margin: 0;
    color: var(--text-muted);
  }

  .project-technology {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    vertical-align: middle;
  }

  .project-technology__logo {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
  }

  section {
    max-width: 48rem;
    margin-top: 2.5rem;
  }

  h2 {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    letter-spacing: -0.025em;
  }

  section p,
  section ul {
    margin-top: 1rem;
  }

  p,
  section li {
    color: var(--text-muted);
  }

  section ul {
    padding-inline-start: 1.25rem;
  }

  section li + li {
    margin-top: 0.75rem;
  }

  .project-gallery {
    max-width: none;
  }

  .project-gallery__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    justify-items: center;
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .project-gallery__list li {
    width: min(100%, 16rem);
  }

  .project-gallery__list li + li {
    margin-top: 0;
  }

  .project-gallery__list--wide {
    grid-template-columns: minmax(0, 1fr);
  }

  .project-gallery__list--wide li {
    width: 100%;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .project-facts {
      grid-template-columns: 2fr 2fr 1fr;
    }
  }
</style>
