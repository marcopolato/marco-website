---
import { messages, type Locale } from '../../i18n/messages.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactLinks from '../ContactLinks.astro';
import { getPageUrl } from '../../i18n/paths.ts';
import portrait from '../../assets/profile/marco.webp';
import { Image } from 'astro:assets';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
---

<BaseLayout
  locale={locale}
  title={t.pageTitle}
  description={t.pageMetaContentDescription}
>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero__content">
      <h1 class="hero__title" id="intro-title">
        {t.heading}
      </h1>

      <p class="hero__role">{t.role}</p>
      <p class="introduction">{t.introduction}</p>

      <div class="actions">
        <a class="button button--primary" href={getPageUrl(locale, 'projects')}>
          {t.exploreProjectsAction}
        </a>

        <a
          class="button button--secondary"
          href={getPageUrl(locale, 'experience')}
        >
          {t.backgroundAction}
        </a>
      </div>
    </div>

    <div class="hero__media">
      <Image
        src={portrait}
        alt={t.portraitAlt}
        width={768}
        layout="constrained"
        sizes="(min-width: 26rem) 384px, calc(100vw - 2rem)"
        priority
        class="hero__image"
      />
    </div>
  </section>

  <div class="info-grid">
    <section class="panel" aria-labelledby="interests-title">
      <h2 id="interests-title">{t.interestsTitle}</h2>
      <ul class="interests">
        {t.interests.map((interest) => (
          <li>{interest}</li>
        ))}
      </ul>
    </section>
  </div>

  <section class="contacts" id="contacts" aria-labelledby="contacts-title">
    <h2 id="contacts-title">{t.contactsTitle}</h2>
    <ContactLinks locale={locale} />
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2.5rem, 7vw, 6rem);
  }

  .hero__content {
    min-width: 0;
  }

  .hero__title {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.055em;
  }

  .hero__role {
    max-width: 42ch;
    margin-top: 1.25rem;
    color: var(--accent-text);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 500;
  }

  .introduction {
    max-width: 42ch;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }

  .button--primary {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--on-brand);
  }

  .button--secondary {
    background: var(--surface);
    color: var(--text);
  }

  .button:hover {
    text-decoration: underline;
  }

  .hero__media {
    width: min(100%, 24rem);
    min-width: 0;
    aspect-ratio: 4 / 5;
    justify-self: center;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--surface);
    color: var(--text-muted);
  }

  .hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .info-grid {
    display: grid;
    gap: 1.5rem;
  }

  .panel {
    min-width: 0;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  h2 {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .interests li {
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--text-muted);
  }

  .contacts {
    margin-top: 1.5rem;
    scroll-margin-top: 2rem;
  }

  .contacts__title {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  @media (min-width: 48rem) {
    .info-grid {
      grid-template-columns: 1fr 1fr;
    }

    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    }

    .hero__media {
      justify-self: end;
    }
  }
</style>
