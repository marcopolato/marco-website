---
import { messages, type Locale } from '../../i18n/messages.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactLinks from '../ContactLinks.astro';
import { getPageUrl, getProjectUrl } from '../../i18n/paths.ts';
import { projects } from '../../data/projects';
import portrait from '../../assets/profile/marco.webp';
import { Image } from 'astro:assets';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const featuredProject = projects.find(
  (project) => project.id === 'marco-website',
);
---

<BaseLayout
  locale={locale}
  title={t.pageTitle}
  description={t.pageMetaContentDescription}
  visualVariant="editorial"
>
  <section class="hero" aria-labelledby="intro-title">
    <div>
      <h1 class="hero__title" id="intro-title">
        {t.heroTitle} <span class="hero__accent">{t.heroTitleAccent}</span>
      </h1>

      <p class="hero__intro">{t.introduction}</p>

      <div class="hero__actions">
        <a class="hero__primary" href={getPageUrl(locale, 'projects')}>
          {t.exploreProjectsAction}
        </a>
        <a class="hero__secondary" href={getPageUrl(locale, 'experience')}>
          {t.backgroundAction}
        </a>
      </div>
    </div>

    <div class="hero__media">
      <Image
        src={portrait}
        alt={t.portraitAlt}
        width={672}
        layout="constrained"
        sizes="(min-width: 52rem) 336px, (min-width: 28rem) 384px, calc(100vw - 2rem)"
        priority
        class="hero__image"
      />
    </div>
  </section>

  {featuredProject && (
    <section class="featured" aria-labelledby="featured-title">
      <h2 id="featured-title">{t.featuredProjectTitle}</h2>

      <article class="featured__project" aria-labelledby="featured-name">
        <div>
          <h3 id="featured-name">{featuredProject.title}</h3>
          <p class="featured__status">
            {featuredProject.status === 'in-progress'
              ? t.projectInProgress
              : t.projectCompleted}
          </p>
          <p class="featured__role">{featuredProject.content[locale].role}</p>
          <a
            class="featured__link"
            href={getProjectUrl(locale, featuredProject.slug)}
          >
            {t.viewProjectDetails}
          </a>
        </div>

        {featuredProject.image && (
          <Image
            src={featuredProject.image.src}
            alt={featuredProject.image.alt[locale]}
            width={960}
            layout="constrained"
            sizes="(min-width: 72rem) 520px, (min-width: 52rem) 46vw, calc(100vw - 2rem)"
            class="featured__image"
          />
        )}
      </article>
    </section>
  )}

  <div class="info-grid">
    <section class="panel" aria-labelledby="interests-title">
      <h2 id="interests-title">{t.interestsTitle}</h2>
      <ul class="interests">
        {t.interests.map((interest) => (
          <li>{interest}</li>
        ))}
      </ul>
    </section>
  </div>

  <section class="contacts" id="contacts" aria-labelledby="contacts-title">
    <h2 id="contacts-title">{t.contactsTitle}</h2>
    <ContactLinks locale={locale} />
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-items: center;
    gap: clamp(1.75rem, 5vw, 4rem);
    padding-block: clamp(2.75rem, 6vw, 5rem);
  }

  .hero__title {
    font-size: clamp(2.375rem, 5.2vw, 4.5rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  .hero__accent {
    display: block;
    color: var(--accent-text);
    font-family: var(--font-source-serif, Georgia, serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .hero__intro {
    max-width: 49ch;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
  }

  .hero__primary,
  .hero__secondary,
  .featured__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .hero__primary {
    padding: 0.65rem 1rem;
    border-radius: 0.5rem;
    background: var(--brand);
    color: var(--on-brand);
    text-decoration: none;
  }

  .hero__primary:hover {
    text-decoration: underline;
  }

  .hero__secondary,
  .featured__link {
    color: var(--text);
  }

  .hero__media {
    width: min(100%, 24rem);
    aspect-ratio: 12 / 10;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--surface);
  }

  .hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }

  .featured {
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--rule);
  }

  .featured__project {
    display: grid;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 3rem);
    margin-top: 1.25rem;
  }

  .featured__project h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.2;
  }

  .featured__status,
  .featured__role {
    color: var(--text-muted);
  }

  .featured__status {
    margin-top: 0.35rem;
    font-size: 0.875rem;
  }

  .featured__role {
    max-width: 48ch;
    margin-top: 0.75rem;
  }

  .featured__link {
    margin-top: 0.5rem;
  }

  .featured__image {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0.375rem;
  }

  .info-grid {
    display: grid;
    gap: 1.5rem;
  }

  .panel {
    min-width: 0;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  h2 {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .interests li {
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--text-muted);
  }

  .contacts {
    margin-top: 1.5rem;
    scroll-margin-top: 2rem;
  }

  .contacts__title {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  @media (min-width: 48rem) {
    .info-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
    }

    .hero__media {
      aspect-ratio: 4 / 5;
    }

    .featured__project {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
  }
</style>
