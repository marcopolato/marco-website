---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceSection from '../ExperienceSection.astro';
import { messages, type Locale } from '../../i18n/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
---

<BaseLayout
  locale={locale}
  title={`${t.experienceNavLabel} | Marco Polato`}
  description={t.experiencePageDescription}
>
  <div class="experience-page">
    <header class="experience-page__intro">
      <h1>{t.experienceNavLabel}</h1>
      <p>{t.experiencePageDescription}</p>
    </header>

    <ExperienceSection locale={locale} />
  </div>
</BaseLayout>

<style>
  .experience-page {
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .experience-page__intro {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    letter-spacing: -0.04em;
  }

  .experience-page__intro p {
    max-width: 42rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
  }
</style>
