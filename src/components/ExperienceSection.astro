---
import { education, professionalExperience } from '../data/experience';
import { messages, type Locale } from '../i18n/messages';
import ExperienceItem from './ExperienceItem.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
---

<div class="experience" id="experience">
  <section
    class="experience__group"
    aria-labelledby="professional-experience-title"
  >
    <h2 id="professional-experience-title">{t.professionalExperienceTitle}</h2>
    <ol class="timeline" role="list">
      {professionalExperience.map((item) => (
        <ExperienceItem item={item} locale={locale} />
      ))}
    </ol>
  </section>

  <section class="experience__group" aria-labelledby="education-title">
    <h2 id="education-title">{t.educationTitle}</h2>
    <ol class="timeline" role="list">
      {education.map((item) => (
        <ExperienceItem item={item} locale={locale} />
      ))}
    </ol>
  </section>
</div>

<style>
  .experience {
    scroll-margin-top: 2rem;
  }

  .experience__group + .experience__group {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .experience__group > h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    letter-spacing: -0.025em;
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
