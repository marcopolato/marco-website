---
import type {
  EducationEntry,
  ProfessionalExperience,
} from '../data/experience';
import { formatExperienceDate } from '../i18n/dates';
import { messages, type Locale } from '../i18n/messages';

interface Props {
  item: ProfessionalExperience | EducationEntry;
  locale: Locale;
}

const { item, locale } = Astro.props;
const content = item.content[locale];
const t = messages[locale];
const isEducation = item.kind === 'education';
const headingId = `experience-${item.id}`;
---

<li
  class:list={[
    'experience-item',
    { 'experience-item--ongoing': item.period.ongoing },
  ]}
>
  <p class="experience-item__period">
    <time datetime={item.period.start}>
      {formatExperienceDate(item.period.start, locale)}
    </time>
    {' – '}
    {item.period.ongoing ? (
      <span>{t.experiencePresent}</span>
    ) : (
      <time datetime={item.period.end}>
        {formatExperienceDate(item.period.end, locale)}
      </time>
    )}
  </p>

  <article class="experience-item__content" aria-labelledby={headingId}>
    <h3 id={headingId}>{content.title}</h3>
    <p class="experience-item__organization">
      {item.organization}
      {item.location && <span> — {item.location}</span>}
    </p>
    {item.period.ongoing && (
      <p class="experience-item__badge">
        {isEducation ? t.educationInProgress : t.experienceCurrent}
      </p>
    )}
    {content.description && (
      <p class="experience-item__description">{content.description}</p>
    )}

    {item.kind === 'professional' &&
      item.coordinatorSince &&
      item.addressedPoints && (
        <div class="coordination">
          <h4>
            {t.coordinatorSinceLabel}{' '}
            <time datetime={item.coordinatorSince}>
              {formatExperienceDate(item.coordinatorSince, locale)}
            </time>
          </h4>
          <ul>
            {item.addressedPoints[locale].map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      )}
  </article>
</li>

<style>
  .experience-item {
    --timeline-marker: 0.625rem;
    --timeline-axis: calc(var(--timeline-marker) / 2);
    --timeline-y: 2.0625rem;
    position: relative;
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    padding-block: 1.375rem;
    padding-inline-start: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .experience-item:not(:last-child)::before {
    position: absolute;
    inset-block-start: var(--timeline-y);
    inset-block-end: calc(-1px - var(--timeline-y));
    inset-inline-start: calc(var(--timeline-axis) - 0.5px);
    width: 1px;
    background: var(--border);
    content: '';
  }

  .experience-item::after {
    position: absolute;
    inset-block-start: calc(var(--timeline-y) - var(--timeline-marker) / 2);
    inset-inline-start: calc(var(--timeline-axis) - var(--timeline-marker) / 2);
    width: var(--timeline-marker);
    height: var(--timeline-marker);
    border: 1px solid var(--accent-text);
    border-radius: 50%;
    background: var(--page);
    content: '';
  }

  .experience-item--ongoing::after {
    background: var(--accent-text);
  }

  .experience-item__period {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .experience-item__content {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .experience-item__content h3 {
    margin: 0;
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .experience-item__organization {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
  }

  .experience-item__organization span,
  .experience-item__description,
  .coordination ul {
    color: var(--text-muted);
  }

  .experience-item__badge {
    margin-top: 0.375rem;
    color: var(--accent-text);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .experience-item__description {
    max-width: 68ch;
    margin-top: 0.75rem;
  }

  .coordination {
    max-width: 68ch;
    margin-top: 1rem;
  }

  .coordination h4 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .coordination ul {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding-inline-start: 1.25rem;
  }

  @media (min-width: 48rem) {
    .experience-item {
      --date-column: 12rem;
      --column-gap: 1.5rem;
      --timeline-axis: calc(var(--date-column) + var(--column-gap) / 2);
      --timeline-y: 2.3125rem;
      grid-template-columns: var(--date-column) minmax(0, 1fr);
      align-items: start;
      column-gap: var(--column-gap);
      padding-inline-start: 0;
    }

    .experience-item__period {
      padding-top: 0.25rem;
    }
  }
</style>
