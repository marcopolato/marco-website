---
import type {
  EducationEntry,
  ProfessionalExperience,
} from '../data/experience';
import { formatExperienceDate } from '../i18n/dates';
import { messages, type Locale } from '../i18n/messages';

interface Props {
  item: ProfessionalExperience | EducationEntry;
  locale: Locale;
}

const { item, locale } = Astro.props;
const content = item.content[locale];
const t = messages[locale];
const isEducation = item.kind === 'education';
const isCurrentAndProfessional = !isEducation && item.period.ongoing;
const headingId = `experience-${item.id}`;
---

<li
  class:list={[
    'experience-item',
    {
      'experience-item--current': isCurrentAndProfessional,
      'experience-item--education': isEducation,
    },
  ]}
>
  <p class="experience-item__period">
    <time datetime={item.period.start}>
      {formatExperienceDate(item.period.start, locale)}
    </time>
    {' – '}
    {item.period.ongoing ? (
      <span>{t.experiencePresent}</span>
    ) : (
      <time datetime={item.period.end}>
        {formatExperienceDate(item.period.end, locale)}
      </time>
    )}
  </p>

  <article class="experience-item__content" aria-labelledby={headingId}>
    {item.period.ongoing && (
      <p class="experience-item__badge">
        {isEducation ? t.educationInProgress : t.experienceCurrent}
      </p>
    )}

    <h4 id={headingId}>{content.title}</h4>
    <p class="experience-item__organization">
      {item.organization}
      {item.location && <span> — {item.location}</span>}
    </p>

    {item.kind === 'professional' && (
      <>
        <p class="experience-item__description">
          {item.content[locale].description}
        </p>

        {item.coordinatorSince && item.addressedPoints && (
          <div class="coordination">
            <h5>
              {t.coordinatorSinceLabel}{' '}
              <time datetime={item.coordinatorSince}>
                {formatExperienceDate(item.coordinatorSince, locale)}
              </time>
            </h5>
            <ul>
              {item.addressedPoints[locale].map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        )}
      </>
    )}
  </article>
</li>

<style>
  .experience-item {
    position: relative;
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    padding-inline-start: 1.75rem;
  }

  /* A quiet timeline rail and marker; these carry no semantic content. */
  .experience-item::before {
    position: absolute;
    top: 0.75rem;
    bottom: -1.25rem;
    inset-inline-start: 0.3125rem;
    width: 1px;
    background: var(--border);
    content: '';
  }

  .experience-item:last-child::before {
    bottom: 0;
  }

  .experience-item::after {
    position: absolute;
    top: 0.5rem;
    inset-inline-start: 0;
    width: 0.6875rem;
    height: 0.6875rem;
    border: 2px solid var(--control-border);
    border-radius: 50%;
    background: var(--page);
    content: '';
  }

  .experience-item--current::after {
    border-color: var(--brand);
    background: var(--brand);
  }

  .experience-item__period {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .experience-item__content {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow-wrap: anywhere;
  }

  .experience-item--current .experience-item__content {
    border-color: var(--accent-text);
    border-top-width: 3px;
  }

  .experience-item__badge {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--accent-text);
    font-size: 0.75rem;
    font-weight: 600;
  }

  h4 {
    margin: 0;
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .experience-item__organization {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
  }

  .experience-item__organization span,
  .experience-item__description {
    color: var(--text-muted);
  }

  .experience-item__description {
    margin-top: 1rem;
  }

  .coordination {
    margin-top: 1.25rem;
    padding: 1rem;
    border-radius: calc(var(--radius) * 0.6);
    background: var(--surface-muted);
  }

  h5 {
    margin: 0;
    color: var(--accent-text);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .coordination ul {
    display: grid;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding-inline-start: 1.25rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .experience-item--education .experience-item__content {
    padding: 1rem 1.25rem;
  }

  .experience-item--education h4 {
    font-size: 1rem;
    letter-spacing: normal;
  }

  @media (min-width: 48rem) {
    .experience-item {
      grid-template-columns: 13rem minmax(0, 1fr);
      align-items: start;
      gap: 1.5rem;
      padding-inline-start: 0;
    }

    .experience-item::before {
      inset-inline-start: calc(13rem + 1.5rem + 0.3125rem);
    }

    .experience-item::after {
      inset-inline-start: calc(13rem + 1.5rem);
    }

    .experience-item__period {
      padding-top: 0.25rem;
    }

    .experience-item__content {
      margin-inline-start: 1.75rem;
    }
  }
</style>
