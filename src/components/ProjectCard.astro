---
import type { Project } from '../data/projects';
import { messages, type Locale } from '../i18n/messages';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const content = project.content[locale];
const t = messages[locale];

const headingId = `project-${project.id}`;

const statusLabel =
  project.status === 'in-progress' ? t.projectInProgress : t.projectCompleted;
---

<article class="project-card" aria-labelledby={headingId}>
  <p class="project-card__status">{statusLabel}</p>

  <h3 class="project-card__title" id={headingId}>
    {project.title}
  </h3>

  <p class="project-card__description">{content.description}</p>

  <p class="project-card__role">
    <strong>{t.projectRoleLabel}: </strong>
    {content.role}
  </p>

  <ul class="project-card__technologies">
    {project.technologies.map((technology) => (
      <li>{technology}</li>
    ))}
  </ul>

  {(project.demoUrl || project.repositoryUrl) && (
    <div class="project-card__links">
      {project.demoUrl && (
        <a
          href={project.demoUrl}
          aria-label={`${t.viewProject}: ${project.title}`}
        >
          {t.viewProject}
        </a>
      )}

      {project.repositoryUrl && (
        <a
          href={project.repositoryUrl}
          aria-label={`${t.viewCode}: ${project.title}`}
        >
          {t.viewCode}
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    height: 100%;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--border);
    border-top: 3px solid var(--brand);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .project-card__status {
    align-self: flex-start;
    margin: 0;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--accent-text);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .project-card__title {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .project-card__description,
  .project-card__role {
    margin: 0;
    color: var(--text-muted);
  }

  .project-card__role strong {
    color: var(--text);
  }

  .project-card__technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-card__technologies li {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .project-card__links a {
    font-weight: 600;
  }
</style>
