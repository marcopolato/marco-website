---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { messages, type Locale } from '../i18n/messages';
import { getProjectUrl } from '../i18n/paths';
import Chip from './Chip.astro';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const content = project.content[locale];
const t = messages[locale];

const headingId = `project-${project.id}`;

const isInProgress = project.status === 'in-progress';
const statusLabel = isInProgress ? t.projectInProgress : t.projectCompleted;
---

<article
  class:list={[
    'project-card',
    { 'project-card--with-image': Boolean(project.image) },
  ]}
  aria-labelledby={headingId}
>
  <div class="project-card__body">
    <h2 class="project-card__title" id={headingId}>
      {project.title}
    </h2>
    <p
      class:list={[
        'project-card__status',
        { 'project-card__status--in-progress': isInProgress },
      ]}
    >
      {statusLabel}
    </p>
    <p class="project-card__description">{content.description}</p>
    <p class="project-card__role">
      <strong>{t.projectRoleLabel}:</strong> {content.role}
    </p>

    <ul class="chip-list" role="list">
      {project.technologies.map((technology) => (
        <li>
          <Chip>{technology}</Chip>
        </li>
      ))}
    </ul>

    <div class="project-card__links">
      <a
        href={getProjectUrl(locale, project.slug)}
        aria-label={`${t.viewProjectDetails}: ${project.title}`}
      >
        {t.viewProjectDetails}
      </a>
      {project.demoUrl && <a href={project.demoUrl}>{t.viewProject}</a>}
      {project.repositoryUrl && (
        <a
          href={project.repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.viewCode}
        </a>
      )}
    </div>
  </div>

  {project.image && (
    <Image
      src={project.image.src}
      alt={project.image.alt[locale]}
      width={960}
      layout="constrained"
      sizes="(min-width: 72rem) 530px, (min-width: 52rem) 50vw, calc(100vw - 2rem)"
      class="project-card__image"
    />
  )}
</article>

<style>
  .project-card {
    display: grid;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 3.5rem);
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--rule);
  }

  .project-card__body {
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }

  .project-card__title {
    font-size: clamp(1.5rem, 3.3vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .project-card__status,
  .project-card__description,
  .project-card__role {
    color: var(--text-muted);
  }

  .project-card__status {
    font-size: 0.875rem;
  }

  .project-card__status--in-progress,
  .project-card__role strong {
    color: var(--accent-text);
    font-weight: 600;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .project-card__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text);
  }

  .project-card__links a:first-child {
    color: var(--accent-text);
    font-weight: 600;
  }

  .project-card__image {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0.375rem;
  }

  @media (min-width: 52rem) {
    .project-card--with-image {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    }
  }
</style>
