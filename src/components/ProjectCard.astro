---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { messages, type Locale } from '../i18n/messages';
import { getProjectUrl } from '../i18n/paths';
import Chip from './Chip.astro';
import ProjectLogo from './ProjectLogo.astro';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const content = project.content[locale];
const t = messages[locale];

const headingId = `project-${project.id}`;

const isInProgress = project.status === 'in-progress';
const statusLabel = isInProgress ? t.projectInProgress : t.projectCompleted;
const { image, branding, technologies } = project;
const coverLogos = branding
  ? [
      branding?.company?.logo,
      ...technologies.map((technology) => branding.technologyLogos[technology]),
    ].filter((logo) => logo !== undefined)
  : [];
const hasMedia = Boolean(image) || coverLogos.length > 0;
const isPortrait = image && image.src.height > image.src.width;
---

<article
  class:list={['project-card', { 'project-card--with-media': hasMedia }]}
  aria-labelledby={headingId}
>
  <div class="project-card__body">
    <h2 class="project-card__title" id={headingId}>
      {content.title}
    </h2>
    <p
      class:list={[
        'project-card__status',
        { 'project-card__status--in-progress': isInProgress },
      ]}
    >
      {statusLabel}
    </p>
    <p class="project-card__description">{content.description}</p>
    <p class="project-card__role">
      <strong>{t.projectRoleLabel}:</strong> {content.role}
    </p>

    <ul class="chip-list" role="list">
      {technologies.map((technology) => {
        const technologyLogo = branding?.technologyLogos[technology];
        return (
          <li>
            <Chip>
              {technologyLogo ? (
                <span class="project-technology">
                  <ProjectLogo
                    src={technologyLogo}
                    width={48}
                    class="project-technology__logo"
                  />
                  {technology}
                </span>
              ) : (
                technology
              )}
            </Chip>
          </li>
        );
      })}
    </ul>

    <div class="project-card__links">
      <a
        href={getProjectUrl(locale, project.slug)}
        aria-label={`${t.viewProjectDetails}: ${content.title}`}
      >
        {t.viewProjectDetails}
      </a>
      {project.demoUrl && <a href={project.demoUrl}>{t.viewProject}</a>}
      {project.repositoryUrl && (
        <a
          href={project.repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.viewCode}
        </a>
      )}
    </div>
  </div>

  {hasMedia && (
    <div class="project-card__media">
      {image ? (
        <Image
          src={image.src}
          alt={image.alt[locale]}
          width={isPortrait ? Math.min(image.src.width, 448) : 960}
          layout="constrained"
          sizes={
            isPortrait
              ? '224px'
              : '(min-width: 72rem) 530px, (min-width: 52rem) 50vw, calc(100vw - 2rem)'
          }
          class:list={[
            'project-card__image',
            { 'project-card__image--portrait': isPortrait },
          ]}
        />
      ) : (
        <div class="project-logo-cover" aria-hidden="true">
          {coverLogos.map((logo) => (
            <div class="project-logo-cover__mark">
              <ProjectLogo
                src={logo}
                width={192}
                class="project-logo-cover__asset"
              />
            </div>
          ))}
        </div>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    display: grid;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 3.5rem);
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--rule);
  }

  .project-card__body {
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }

  .project-card__title {
    font-size: clamp(1.5rem, 3.3vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .project-card__status,
  .project-card__description,
  .project-card__role {
    color: var(--text-muted);
  }

  .project-card__status {
    font-size: 0.875rem;
  }

  .project-card__status--in-progress,
  .project-card__role strong {
    color: var(--accent-text);
    font-weight: 600;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .project-card__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text);
  }

  .project-card__links a:first-child {
    color: var(--accent-text);
    font-weight: 600;
  }

  .project-card__media {
    display: grid;
    min-inline-size: 0;
  }

  .project-card__image {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0.375rem;
  }

  .project-card__image--portrait {
    width: min(100%, 14rem);
    justify-self: center;
  }

  .project-logo-cover {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 4vw, 2rem);
    aspect-ratio: 16 / 9;
    padding: 1rem 12%;
    border: 1px solid var(--rule);
    border-radius: 0.375rem;
    background: #211d1a;
  }

  .project-logo-cover__mark {
    flex: 0 1 4.25rem;
    min-inline-size: 0;
    aspect-ratio: 1;
  }

  .project-logo-cover__mark:first-child {
    flex-basis: 5.5rem;
  }

  .project-logo-cover__asset {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .project-technology {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    vertical-align: middle;
  }

  .project-technology__logo {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
  }

  @media (min-width: 52rem) {
    .project-card--with-media {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    }
  }
</style>
