---
import BaseLayout from '../layouts/BaseLayout.astro';
import { messages, type Locale } from '../i18n/messages';
import { projects } from '../data/projects.ts';
import ProjectCard from './ProjectCard.astro';
import ContactLinks from './ContactLinks.astro';
import ExperienceSection from './ExperienceSection.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
---

<BaseLayout locale={locale} title={t.pageTitle} description={t.pageDescription}>
  <section class="hero" aria-labelledby="intro-title">
    <p class="eyebrow">{t.role}</p>
    <h1 id="intro-title">{t.heading}</h1>
    <p class="introduction">{t.introduction}</p>
  </section>

  <ExperienceSection locale={locale} />

  <section class="projects" id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title">{t.projectsTitle}</h2>

    <p class="projects__intro">{t.projectsDescription}</p>

    <div class="projects__grid">
      {projects.map((project) => (
        <ProjectCard project={project} locale={locale} />
      ))}
    </div>
  </section>

  <div class="info-grid">
    <section class="panel" aria-labelledby="interests-title">
      <h2 id="interests-title">{t.interestsTitle}</h2>
      <ul class="interests">
        {t.interests.map((interest) => (
          <li>{interest}</li>
        ))}
      </ul>
    </section>

    <aside class="panel status" aria-labelledby="status-title">
      <h2 id="status-title">{t.statusTitle}</h2>
      <p>{t.statusDescription}</p>
    </aside>
  </div>

  <section class="contacts" aria-labelledby="contacts-title">
    <h2 id="contacts-title">{t.contactsTitle}</h2>
    <ContactLinks locale={locale} />
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 7rem);
  }

  .eyebrow {
    margin-bottom: 1.25rem;
    color: var(--accent-text);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 15ch;
    font-size: clamp(2.75rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.055em;
  }

  .introduction {
    max-width: 42rem;
    margin-top: 1.75rem;
    color: var(--text-muted);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .actions {
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--control-border);
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }

  .button--primary {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--on-brand);
  }

  .button--secondary {
    background: var(--surface);
    color: var(--text);
  }

  .button:hover {
    text-decoration: underline;
  }

  .info-grid {
    display: grid;
    gap: 1.5rem;
  }

  .panel {
    min-width: 0;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  h2 {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .interests li {
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--text-muted);
  }

  .status {
    border-top: 3px solid var(--brand);
  }

  .status p {
    margin-top: 1rem;
    color: var(--text-muted);
  }

  .contacts {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .projects {
    margin-bottom: 3rem;
  }

  .projects__intro {
    max-width: 42rem;
    margin-top: 0.75rem;
    color: var(--text-muted);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 48rem) {
    .info-grid {
      grid-template-columns: 1fr 1fr;
    }

    .projects__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
