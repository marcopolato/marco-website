---
import { messages, type Locale } from '../i18n/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-label-light={t.switchToLight}
  data-label-dark={t.switchToDark}
  aria-label={t.switchToLight}
  title={t.switchToLight}
  hidden
>
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <g class="theme-toggle__sun">
      <circle cx="12" cy="12" r="4" />
      <path
        d="M12 2v2 M12 20v2 M2 12h2 M20 12h2
           M5 5l1.5 1.5 M17.5 17.5 19 19
           M5 19l1.5-1.5 M17.5 6.5 19 5"
      />
    </g>

    <path
      class="theme-toggle__moon"
      d="M20.5 13A8.5 8.5 0 0 1 11 3.5
         8.5 8.5 0 1 0 20.5 13Z"
    />
  </svg>
</button>

<script>
  const root = document.documentElement;
  const themeToggleButton = document.getElementById('theme-toggle');

  function updateButtonAriaCheckedValue() {
    const isDarkTheme = root.dataset.theme !== 'light';

    if (themeToggleButton) {
      const label = isDarkTheme
        ? (themeToggleButton.dataset.labelLight ?? '')
        : (themeToggleButton.dataset.labelDark ?? '');

      themeToggleButton.setAttribute('aria-label', label);
      themeToggleButton.title = label;
    }
  }

  if (themeToggleButton) {
    themeToggleButton.addEventListener('click', () => {
      const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = nextTheme;
      updateButtonAriaCheckedValue();

      try {
        localStorage.setItem('marco-theme', nextTheme);
      } catch (e) {
        // The change remains on the current page.
        console.error('Error accessing localStorage for theme:', e);
      }
    });
  }

  updateButtonAriaCheckedValue();
  if (themeToggleButton) {
    themeToggleButton.hidden = false;
  }
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: var(--surface);
    color: var(--accent-text);
  }

  .theme-toggle__moon {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle__sun {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle__moon {
    display: inline;
  }
</style>
