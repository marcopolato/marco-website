---
import { messages, type Locale } from '../i18n/messages';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  role="switch"
  aria-label={t.darkThemeLabel}
  aria-checked="true"
  data-theme-toggle
  hidden
>
  <span class="theme-toggle__thumb" aria-hidden="true"></span>

  <Icon name="sun" size={20} class="theme-toggle__icon theme-toggle__sun" />
  <Icon name="moon" size={20} class="theme-toggle__icon theme-toggle__moon" />
</button>

<script>
  const root = document.documentElement;
  const themeToggleButton = document.getElementById('theme-toggle');

  function updateButtonAriaCheckedValue() {
    const isDarkTheme = root.dataset.theme !== 'light';

    if (themeToggleButton) {
      themeToggleButton.setAttribute('aria-checked', String(isDarkTheme));
    }
  }

  if (themeToggleButton) {
    themeToggleButton.addEventListener('click', () => {
      const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = nextTheme;
      updateButtonAriaCheckedValue();

      try {
        localStorage.setItem('marco-theme', nextTheme);
      } catch (e) {
        // The change remains on the current page.
        console.error('Error accessing localStorage for theme:', e);
      }
    });
  }

  updateButtonAriaCheckedValue();
  if (themeToggleButton) {
    themeToggleButton.hidden = false;
  }
</script>

<style>
  .theme-toggle {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 2rem);
    align-items: center;
    justify-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
    width: 5.25rem;
    height: 2.75rem;
    padding: 0.375rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--accent-text);
  }

  .theme-toggle__thumb {
    position: absolute;
    top: 0.3125rem;
    left: 0.375rem;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--brand);
    pointer-events: none;
  }

  .theme-toggle__icon {
    position: relative;
    z-index: 1;
  }

  .theme-toggle[aria-checked='true'] .theme-toggle__thumb {
    transform: translateX(2.375rem);
  }

  .theme-toggle[aria-checked='false'] .theme-toggle__sun,
  .theme-toggle[aria-checked='true'] .theme-toggle__moon {
    color: var(--on-brand);
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle__thumb {
      transition: transform 220ms ease-in-out;
    }

    .theme-toggle__icon {
      transition: color 220ms ease-in-out;
    }
  }
</style>
