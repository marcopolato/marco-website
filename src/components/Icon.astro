---
import type { HTMLAttributes, SvgComponent } from 'astro/types';

import LinkedInIcon from '@phosphor-icons/core/assets/regular/linkedin-logo.svg';
import WhatsAppIcon from '@phosphor-icons/core/assets/regular/whatsapp-logo.svg';
import PhoneIcon from '@phosphor-icons/core/assets/regular/phone.svg';
import EnvelopeIcon from '@phosphor-icons/core/assets/regular/envelope.svg';
import InstagramIcon from '@phosphor-icons/core/assets/regular/instagram-logo.svg';
import GitHubIcon from '@phosphor-icons/core/assets/regular/github-logo.svg';
import SunIcon from '@phosphor-icons/core/assets/regular/sun.svg';
import MoonIcon from '@phosphor-icons/core/assets/regular/moon.svg';
import CaretDownIcon from '@phosphor-icons/core/assets/regular/caret-down.svg';
import TerminalWindow from '@phosphor-icons/core/assets/regular/terminal-window.svg';

const icons = {
  'brand-linkedin': LinkedInIcon,
  'brand-whatsapp': WhatsAppIcon,
  phone: PhoneIcon,
  mail: EnvelopeIcon,
  'brand-instagram': InstagramIcon,
  'brand-github': GitHubIcon,
  sun: SunIcon,
  moon: MoonIcon,
  'caret-down': CaretDownIcon,
  'terminal-window': TerminalWindow,
} satisfies Record<string, SvgComponent>;

interface Props extends HTMLAttributes<'svg'> {
  name: keyof typeof icons;
  size?: number;
}

const { name, size = 22, ...attributes } = Astro.props;
const Svg = icons[name];

if (!Svg) {
  throw new Error(`Icon not found: ${name}`);
}
---

<Svg
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  {...attributes}
/>
