---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { messages, type Locale } from '../i18n/messages';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const t = messages[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <header>
      <a class="brand" href={getRelativeLocaleUrl(locale)}>
        Marco Polato
      </a>

      <nav aria-label={t.languageLabel}>
        <a
          href={getRelativeLocaleUrl('it')}
          lang="it"
          hreflang="it"
          aria-current={locale === 'it' ? 'page' : undefined}
        >
          IT
        </a>

        <a
          href={getRelativeLocaleUrl('en')}
          lang="en"
          hreflang="en"
          aria-current={locale === 'en' ? 'page' : undefined}
        >
          EN
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    color: #f5f5fa;
    background: radial-gradient(circle at top left, #29203f, #101116 55%);
  }

  a {
    color: inherit;
  }

  a:focus-visible {
    outline: 3px solid #c4b5fd;
    outline-offset: 5px;
  }
</style>

<style>
  header,
  main {
    width: calc(100% - 3rem);
    max-width: 64rem;
    margin-inline: auto;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.5rem;
  }

  .brand {
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 0.5rem;
  }

  nav a {
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: #c4b5fd;
    background: #302544;
  }

  main {
    padding-block: 3rem;
  }
</style>
