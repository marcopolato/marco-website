---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Font } from 'astro:assets';
import { messages, type Locale } from '../i18n/messages';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
import LanguageMenu from '../components/LanguageMenu.astro';
import { getHomeExperienceUrl, getHomeProjectsUrl } from '../i18n/paths';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  projectSlug?: string;
}

const { locale, title, description, projectSlug } = Astro.props;
const t = messages[locale];
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <Font cssVariable="--font-inter" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main">
      {t.skipToContent}
    </a>
    <header class="site-header container">
      <a class="brand" href={getRelativeLocaleUrl(locale)}>
        <span class="brand__mark" aria-hidden="true"></span>
        Marco Polato
      </a>

      <nav class="site-nav" aria-label={t.navigationLabel}>
        <ul>
          <li>
            <a href={getHomeExperienceUrl(locale)}>{t.experienceNavLabel}</a>
          </li>
          <li>
            <a href={getHomeProjectsUrl(locale)}>{t.projectsTitle}</a>
          </li>
        </ul>
      </nav>

      <div class="header-controls">
        <LanguageMenu locale={locale} projectSlug={projectSlug} />
        <ThemeToggle locale={locale} />
      </div>
    </header>

    <main class="container" id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} Marco Polato</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand__mark {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--brand);
  }

  .header-controls {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0.75rem;
  }

  .site-nav {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    background: var(--surface-muted);
    color: var(--accent-text);
  }

  .site-footer {
    margin-top: 4rem;
    padding-block: 2rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  @media (max-width: 35rem) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .header-controls {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (min-width: 48rem) {
    .site-nav {
      width: auto;
      border-radius: 999px;
    }
  }
</style>
