---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Font } from 'astro:assets';
import { messages, type Locale } from '../i18n/messages';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const t = messages[locale];
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <Font cssVariable="--font-inter" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main">
      {t.skipToContent}
    </a>
    <header class="site-header container">
      <a class="brand" href={getRelativeLocaleUrl(locale)}>
        <span class="brand__mark" aria-hidden="true"></span>
        Marco Polato
      </a>

      <div class="header-controls">
        <nav class="language-switch" aria-label={t.languageLabel}>
          <a
            href={getRelativeLocaleUrl('it')}
            lang="it"
            hreflang="it"
            aria-label="Italiano"
            title="Italiano"
            aria-current={locale === 'it' ? 'page' : undefined}
          >
            <span aria-hidden="true">🇮🇹</span>
            IT
          </a>

          <a
            href={getRelativeLocaleUrl('en')}
            lang="en"
            hreflang="en"
            aria-label="English"
            title="English"
            aria-current={locale === 'en' ? 'page' : undefined}
          >
            <span aria-hidden="true">🇬🇧</span>
            EN
          </a>
        </nav>
        <ThemeToggle locale={locale} />
      </div>
    </header>

    <main class="container" id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} Marco Polato</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand__mark {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--brand);
  }

  .header-controls {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0.75rem;
  }

  .language-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.1875rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }

  .language-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-width: 2.5rem;
    min-height: 2.25rem;
    padding-inline: 0.6rem;
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }

  .language-switch a:hover {
    color: var(--text);
  }

  .language-switch a[aria-current='page'] {
    background: var(--surface-muted);
    color: var(--accent-text);
  }

  .site-footer {
    margin-top: 4rem;
    padding-block: 2rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  @media (max-width: 35rem) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .header-controls {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
