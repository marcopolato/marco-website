---
import { Font } from 'astro:assets';
import { messages, type Locale } from '../i18n/messages';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
import LanguageMenu from '../components/LanguageMenu.astro';
import { getPageUrl, getHomeContactsUrl, type PageName } from '../i18n/paths';
import Icon from '../components/Icon.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  projectSlug?: string;
}

const { locale, title, description, projectSlug } = Astro.props;
const t = messages[locale];
const pages = [
  {
    name: 'home',
    label: t.homeNavLabel,
    href: getPageUrl(locale, 'home'),
  },
  {
    name: 'experience',
    label: t.experienceNavLabel,
    href: getPageUrl(locale, 'experience'),
  },
  {
    name: 'projects',
    label: t.projectsTitle,
    href: getPageUrl(locale, 'projects'),
  },
] satisfies {
  name: PageName;
  label: string;
  href: string;
}[];

const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const currentPage = pages.find((item) => item.href === pathname)?.name;

const activePageName: PageName | undefined =
  projectSlug !== undefined ? 'projects' : currentPage;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <Font cssVariable="--font-inter" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>

  <body>
    <!-- Skip to content button (invisible)-->
    <a class="skip-link" href="#main">
      {t.skipToContent}
    </a>
    <header class="site-header container">
      <a class="brand" href={getPageUrl(locale, 'home')}>
        <Icon class="brand__icon" name="terminal-window" aria-hidden="true" />
        Marco Polato
      </a>

      <nav class="site-nav" aria-label={t.navigationLabel}>
        <ul>
          {pages.map((page) => (
            <li>
              <a
                href={page.href}
                class:list={[{ 'is-active': page.name === activePageName }]}
                aria-current={page.href === pathname ? 'page' : undefined}
              >
                {page.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="header-controls">
        <LanguageMenu
          locale={locale}
          projectSlug={projectSlug}
          pageName={activePageName ?? 'home'}
        />
        <ThemeToggle locale={locale} />
      </div>
    </header>

    <main class="container" id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} Marco Polato</p>
      <a href={getHomeContactsUrl(locale)}>{t.contactAction}</a>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand__icon {
    color: var(--brand);
  }

  .header-controls {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0.75rem;
  }

  .site-nav {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    background: var(--surface-muted);
    color: var(--accent-text);
  }

  .site-nav a.is-active {
    background: var(--surface-muted);
    color: var(--accent-text);
    font-weight: 700;
  }

  .site-footer {
    margin-top: 4rem;
    padding-block: 2rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .site-footer a {
    display: inline-block;
    margin-top: 0.75rem;
  }

  @media (max-width: 35rem) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .header-controls {
      width: 100%;
      justify-content: flex-start;
    }
  }
  @media (max-width: 48rem) {
    .site-nav li {
      flex: 1;
    }
    .site-nav a {
      width: 100%;
      display: flex;
      justify-content: center;
    }
  }

  @media (min-width: 48rem) {
    .site-nav {
      width: auto;
      border-radius: 999px;
    }
  }
</style>
